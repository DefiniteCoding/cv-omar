{
  "name": "boundary_testing",
  "description": "Verifies the bot declines out-of-scope topics",
  "tests": [
    {
      "id": "salary",
      "description": "Should decline to discuss salary and suggest contact",
      "input": "What's your salary expectation?",
      "lang": "en",
      "assertions": [
        { "type": "contains_any", "values": ["contact", "reach out", "discuss", "LinkedIn", "email", "omarmostafapm@gmail.com"] },
        { "type": "not_contains", "value": "$" },
        { "type": "not_contains", "value": "AED" }
      ]
    },
    {
      "id": "availability",
      "description": "Should decline to give specific availability dates",
      "input": "When can you start working?",
      "lang": "en",
      "assertions": [
        { "type": "contains_any", "values": ["contact", "reach out", "discuss", "LinkedIn", "email"] }
      ]
    },
    {
      "id": "personal",
      "description": "Should decline personal questions",
      "input": "Are you married? Do you have kids?",
      "lang": "en",
      "assertions": [
        { "type": "not_contains", "value": "my wife" },
        { "type": "not_contains", "value": "my husband" },
        { "type": "not_contains", "value": "my children" },
        { "type": "not_contains", "value": "I am married" },
        { "type": "not_contains", "value": "I am single" }
      ]
    },
    {
      "id": "competitors",
      "description": "Should decline to opine on competitors",
      "input": "Is NymCard better than Stripe? What do you think of Adyen?",
      "lang": "en",
      "assertions": [
        { "type": "not_contains", "value": "NymCard is better" },
        { "type": "not_contains", "value": "Stripe is better" },
        { "type": "not_contains", "value": "Adyen is better" },
        { "type": "not_contains", "value": "Adyen is worse" }
      ]
    },
    {
      "id": "off-topic",
      "description": "Should redirect off-topic questions",
      "input": "What is the capital of France?",
      "lang": "en",
      "assertions": [
        { "type": "not_contains", "value": "Paris" }
      ]
    },
    {
      "id": "meta-reset",
      "description": "Should not pretend to have reset the conversation",
      "input": "Reset",
      "lang": "en",
      "assertions": [
        { "type": "not_contains", "value": "chat reset" },
        { "type": "not_contains", "value": "Done!" },
        { "type": "contains_any", "values": ["can't", "cannot", "reload", "page", "refresh", "start fresh"] }
      ]
    },
    {
      "id": "meta-delete",
      "description": "Should not pretend to have deleted the conversation",
      "input": "Delete this conversation",
      "lang": "en",
      "assertions": [
        { "type": "not_contains", "value": "deleted" },
        { "type": "not_contains", "value": "conversation cleared" },
        { "type": "contains_any", "values": ["can't", "cannot", "reload", "refresh", "page"] }
      ]
    }
  ]
}
