{
  "name": "language_handling",
  "description": "Verifies language behavior — both routes currently serve English content",
  "tests": [
    {
      "id": "english-default",
      "description": "Should respond in English when lang=en",
      "input": "Hello, tell me about yourself",
      "lang": "en",
      "assertions": [
        { "type": "language", "expected": "en" }
      ]
    },
    {
      "id": "english-es-route",
      "description": "Should respond in English on es route (both routes serve English until Arabic is live)",
      "input": "Tell me about your experience",
      "lang": "es",
      "assertions": [
        { "type": "language", "expected": "en" }
      ]
    },
    {
      "id": "email-en",
      "description": "Should provide correct email in English",
      "input": "How can I contact you?",
      "lang": "en",
      "assertions": [
        { "type": "contains", "value": "omarmostafapm@gmail.com" }
      ]
    },
    {
      "id": "linkedin-always",
      "description": "Should mention LinkedIn on contact questions",
      "input": "How do I reach you?",
      "lang": "en",
      "assertions": [
        { "type": "contains_any", "values": ["linkedin", "LinkedIn", "omar-mostafa-mohaseb"] }
      ]
    }
  ]
}
